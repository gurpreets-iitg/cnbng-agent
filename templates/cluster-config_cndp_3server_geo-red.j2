            <value>oam</value>
          </node-labels>
          <node-labels>
            <key>smi.cisco.com/sess-type</key>
            <value>cdl-node</value>
          </node-labels>
          <node-labels>
            <key>smi.cisco.com/svc-type</key>
            <value>service</value>
          </node-labels>
        </k8s>
        <ucs-server>
          <cimc>
            <user>{{cnbng_cp.ucs03.cimc.user}}</user>
            <password>{{cnbng_cp.ucs03.cimc.password}}</password>
            <bios>
              <configured-boot-mode>{{cnbng_cp.node_defaults.cimc_boot_mode}}</configured-boot-mode>
            </bios>
            <ip-address>{{cnbng_cp.ucs03.cimc.ip}}</ip-address>
          </cimc>
        </ucs-server>
        <initial-boot>
          <netplan>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.k8s.intf}}.k8s.{{cnbng_cp.cluster.networks.k8s.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs03.networks.k8s.ip}}</addresses>
              <id>{{cnbng_cp.cluster.networks.k8s.id}}</id>
              <link>{{cnbng_cp.cluster.networks.k8s.intf}}</link>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.mgmt.intf}}.mgmt.{{cnbng_cp.cluster.networks.mgmt.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs03.networks.mgmt.ip}}</addresses>
              {% if cnbng_cp.ucs03.networks.mgmt.get('gateway') %}
              <routes>
                <to>0.0.0.0/0</to>
                <via>{{cnbng_cp.ucs03.networks.mgmt.gateway}}</via>
              </routes>
              {% endif %}
              <id>{{cnbng_cp.cluster.networks.mgmt.id}}</id>
              <link>{{cnbng_cp.cluster.networks.mgmt.intf}}</link>
            </vlans>
            {% if cnbng_cp.ucs03.networks.get('inttcp') %}
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.inttcp.intf}}.inttcp.{{cnbng_cp.cluster.networks.inttcp.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs03.networks.inttcp.ip}}</addresses>
              {% if cnbng_cp.ucs03.networks.inttcp.get('route') %}
              <routes>
                <to>{{cnbng_cp.ucs03.networks.inttcp.route.to}}</to>
                <via>{{cnbng_cp.ucs03.networks.inttcp.route.via}}</via>
              </routes>
              {% endif %}
              <id>{{cnbng_cp.cluster.networks.inttcp.id}}</id>
              <link>{{cnbng_cp.cluster.networks.inttcp.intf}}</link>
            </vlans>
            {% endif %}
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.cdl.intf}}.cdl.{{cnbng_cp.cluster.networks.cdl.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs03.networks.cdl.ip}}</addresses>
              <routes>
                <to>{{cnbng_cp.ucs03.networks.cdl.route.to}}</to>
                <via>{{cnbng_cp.ucs03.networks.cdl.route.via}}</via>
              </routes>
              <id>{{cnbng_cp.cluster.networks.cdl.id}}</id>
              <link>{{cnbng_cp.cluster.networks.cdl.intf}}</link>
            </vlans>
          </netplan>
        </initial-boot>
        <os>
          <additional-ssh-ips>{{cnbng_cp.ucs03.networks.mgmt.ip.split('/')[0]}}</additional-ssh-ips>
          <tuned>
            <enabled>true</enabled>
          </tuned>
        </os>
      </nodes>
      <virtual-ips>
        <group>cdlvip</group>
        <check-interface>
